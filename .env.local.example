# Local dev only — copy to .env.local (which is gitignored) and fill values.
# Production / Preview values are set in Vercel team Shared env vars, not here.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Pull these from Supabase → step-prod → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Pull these from your password manager (already set in Vercel team env)
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@step.careers
